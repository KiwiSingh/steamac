# steamac: full replacement of the stock deckard steam.service.
# Differences from stock:
#  - no Wants/After=steamvr.service; ordered after gamescope-session.service
#    instead (stock got that ordering transitively through steamvr.service),
#    so DISPLAY etc. are imported by gamescope-onready before Steam starts;
#  - no STEAM_LAUNCH_WRAPPER_AFFINITY_LIST / STEAM_DESKTOP_APP_AFFINITY_LIST=0xf8:
#    that pins games to the SM8650 big cores 3-7; VM vCPUs are uniform and the
#    VM may have fewer than 8 of them;
#  - /usr/lib/steamac/steam-gfx-env points the stock 4 GiB VRAM report limit
#    at the Venus device instead of the Adreno device ID.
#  - RUNSTEAM.sh is copied with cp -f instead of cp -u, so the steamac version
#    (stock by default; opt-in public client branch via
#    /etc/steamac/steam-client-branch, see that file) also replaces the copy
#    unpacked from the Frame steam.tar.zst, which can be newer.
# Everything else (bootstrap, health check) is stock.
[Unit]
Description=Steam Launcher
PartOf=graphical-session.target
After=gamescope-session.service

[Service]
Slice=session.slice

Type=simple
Restart=always
TimeoutStopSec=20

# Steam bootstrapper uses 42 as the "restart me" exit status, we just consider that normal success
SuccessExitStatus=0 42

# Launch games in their own cgroup for resource tracking purposes
Environment=STEAM_LAUNCH_WRAPPER_SCOPE=true

# Disable Steam trying to do the WPAD proxy autodetection
Environment=STEAM_CEF_USE_AUTOMATIC_PROXY=0

# This enables getUserMedia, restricted to microphone and https://steamloopback.host
Environment=STEAM_DEBUGCEF_FAKEUI=1

# Allow Steam to adopt and unmount drives
Environment=STEAM_ALLOW_DRIVE_ADOPT=1
Environment=STEAM_ALLOW_DRIVE_UNMOUNT=1

Environment="STEAM_COMPAT_TOOL_MAPPINGS=546560 100 steamrt4-any"

# Disable audio namespaces until they deal with multichannel better
Environment="STEAM_LAUNCH_WRAPPER_AUDIO_NAMESPACE=0"

# Drop-ins (e.g. the stock steam.service.d/disable_bootstrapper.conf) set this
Environment=STEAM_EXTRA_ARGS=

# Mesa variables (steamac: Venus/zink)
EnvironmentFile=/usr/share/deckard/mesavars.sh

ExecStartPre=/bin/bash -c "mkdir -p ${XDG_RUNTIME_DIR}/steam/env"
ExecStartPre=/bin/bash -c "cp -f /usr/share/deckard/steam_launch_wrapper_env_defaults.txt ${XDG_RUNTIME_DIR}/steam/env/gfx.txt"
ExecStartPre=-/usr/share/deckard/steam-health-check --track-started
ExecStartPre=/bin/bash -c "cp -f /usr/share/deckard/RUNSTEAM.sh %h/.local/share/Steam/"
ExecStartPre=-/usr/lib/steamac/steam-gfx-env
ExecStart=/usr/share/deckard/select_steam.sh RUNSTEAM.sh
ExecStopPost=-/usr/share/deckard/steam-health-check --track-stopped
