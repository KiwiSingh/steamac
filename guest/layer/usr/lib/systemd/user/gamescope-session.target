# steamac: full replacement of the stock target, without the SteamVR units
# (steamvr, steamvr-logs, steamvr-proxmicmute, steamvr-v4l2cam).
[Unit]
Description=Gamescope Session (steamac VM)
Requires=graphical-session.target
BindsTo=graphical-session.target
After=graphical-session.target
PropagatesStopTo=graphical-session.target

Requires=gamescope-session.service
BindsTo=gamescope-session.service

Wants=steam.service
Wants=steam-notif-daemon.service
Wants=ibus-gamescope.service
