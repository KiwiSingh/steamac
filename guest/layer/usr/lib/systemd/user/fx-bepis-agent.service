# KiwiSingh/steamac: BepisLoader integration agent.
#
# This intentionally exposes only the versioned Bepis bridge protocol.
# It is not a shell and does not accept arbitrary command execution.
[Unit]
Description=Steamac BepisLoader guest bridge
PartOf=gamescope-session.target plasma-session.target
After=gamescope-session.service

[Service]
Type=simple
Slice=session.slice
ExecStart=/usr/lib/steamac/fx-bepis-agent
Restart=on-failure
RestartSec=1
TimeoutStopSec=3
Nice=5
