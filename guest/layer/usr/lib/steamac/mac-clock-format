#!/usr/bin/python3
"""Follow steamac.clock24 before Steam/Plasma starts; an observed user edit wins.

Steam's Time and date toggle uses FriendSettings.SetFriendSettings; steamui.so
stores the JSON at Software/Valve/Steam/FriendsUI/FriendsUIJSON in the account's
UserLocalConfigStore (userdata/<account>/config/localconfig.vdf). No account file
exists before sign-in, so that account gets the Mac format on its next start.
"""
import configparser
import json
import os
from pathlib import Path
import re
import sys
import tempfile


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        os.chmod(tmp, path.stat().st_mode & 0o777 if path.exists() else 0o600)
        os.replace(tmp, path)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def vdf_unquote(token):
    if not token.startswith('"'):
        return token
    return re.sub(r'\\([\\"nrt])', lambda m: {"n": "\n", "r": "\r", "t": "\t"}.get(m[1], m[1]), token[1:-1])


def vdf_quote(value):
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n").replace("\r", "\\r").replace("\t", "\\t") + '"'


def vdf_entries(text):
    """Return scalar spans and block closing offsets; retain every unrelated byte."""
    tokens = [m for m in re.finditer(r'//[^\n]*|"(?:\\.|[^"\\])*"|[{}]|[^\s{}"]+', text)
              if not m[0].startswith("//")]
    values, blocks, stack = {}, {}, []
    i = 0
    while i < len(tokens):
        token = tokens[i]
        if token[0] == "}":
            if not stack:
                raise ValueError("unbalanced VDF closing brace")
            blocks[tuple(stack)] = token.start()
            stack.pop()
            i += 1
            continue
        if token[0] == "{" or i + 1 == len(tokens):
            raise ValueError("incomplete VDF key/value")
        key = vdf_unquote(token[0]).lower()
        value = tokens[i + 1]
        if value[0] == "{":
            stack.append(key)
        elif value[0] == "}":
            raise ValueError("missing VDF value")
        else:
            path = (*stack, key)
            if path in values:
                raise ValueError("duplicate VDF value")
            values[path] = (vdf_unquote(value[0]), value.start(), value.end())
        i += 2
    if stack:
        raise ValueError("unbalanced VDF opening brace")
    return values, blocks


def vdf_set(text, path, value):
    values, blocks = vdf_entries(text)
    key = tuple(part.lower() for part in path)
    if key in values:
        _, start, end = values[key]
        return text[:start] + vdf_quote(value) + text[end:]
    # Add only missing containers, inside the deepest existing ancestor.
    depth = len(key) - 1
    while depth and key[:depth] not in blocks:
        depth -= 1
    if not depth:
        raise ValueError("no UserLocalConfigStore block")
    addition = "\n" + "\t" * depth + vdf_quote(path[-1]) + "\t\t" + vdf_quote(value) + "\n"
    for level in range(len(key) - 2, depth - 1, -1):
        addition = "\n" + "\t" * level + vdf_quote(path[level]) + "\n" + "\t" * level + "{" + addition + "\t" * level + "}\n"
    pos = blocks[key[:depth]]
    return text[:pos] + addition + text[pos:]


def follows(marker, current):
    if marker.get("user"):
        return False
    if "last" in marker and current != marker["last"]:
        marker["user"] = True
        return False
    return True


def main():
    args = Path("/proc/cmdline").read_text().split()
    host = next((arg.split("=", 1)[1] for arg in reversed(args) if arg.startswith("steamac.clock24=")), None)
    if host is None:
        return
    if host not in ("0", "1"):
        print("mac-clock-format: ignoring invalid steamac.clock24=" + host, file=sys.stderr)
        return
    want = host == "1"
    home = Path.home()
    marker_path = home / ".config/steamac/mac-clock24.json"
    state = json.loads(marker_path.read_text()) if marker_path.exists() else {}
    # KDE's Formats setting controls Desktop Mode's locale-derived clocks.
    plasma_path = home / ".config/plasma-localerc"
    plasma = configparser.ConfigParser(interpolation=None)
    plasma.optionxform = str
    plasma.read(plasma_path)
    current = plasma.get("Formats", "LC_TIME", fallback=None)
    marker = state.setdefault("plasma", {})
    if follows(marker, current):
        value = "en_GB.UTF-8" if want else "en_US.UTF-8"
        if current != value:
            # KConfig owns the file syntax (including unrelated locale settings).
            import subprocess
            subprocess.run(["kwriteconfig6", "--file", str(plasma_path), "--group", "Formats", "--key", "LC_TIME", value], check=True)
        marker["last"] = value
        print("mac-clock-format: Plasma LC_TIME=" + value, file=sys.stderr)
    else:
        print("mac-clock-format: keeping Plasma user format", file=sys.stderr)
    path = ("UserLocalConfigStore", "Software", "Valve", "Steam", "FriendsUI", "FriendsUIJSON")
    accounts = state.setdefault("accounts", {})
    for config in sorted((home / ".local/share/Steam/userdata").glob("[0-9]*/config/localconfig.vdf")):
        if not config.parent.parent.name.isdecimal():
            continue
        try:
            text = config.read_text()
            values, _ = vdf_entries(text)
            stored = values.get(tuple(part.lower() for part in path))
            prefs = json.loads(stored[0]) if stored else {}
            if not isinstance(prefs, dict):
                raise ValueError("FriendsUIJSON is not an object")
            current = prefs.get("b24HourClock")
            if current is not None and type(current) not in (bool, int):
                raise ValueError("b24HourClock is not boolean")
            marker = accounts.setdefault(config.parent.parent.name, {})
            if follows(marker, current):
                prefs["b24HourClock"] = want
                if current is None or bool(current) != want:
                    atomic_write(config, vdf_set(text, path, json.dumps(prefs, separators=(",", ":"))))
                marker["last"] = want
                print("mac-clock-format: Steam b24HourClock=" + host, file=sys.stderr)
            else:
                print("mac-clock-format: keeping Steam user format", file=sys.stderr)
        except (OSError, ValueError) as error:
            print("mac-clock-format: leaving account config: " + str(error), file=sys.stderr)
    atomic_write(marker_path, json.dumps(state, sort_keys=True) + "\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError) as error:
        print("mac-clock-format: " + str(error), file=sys.stderr)
        sys.exit(1)
