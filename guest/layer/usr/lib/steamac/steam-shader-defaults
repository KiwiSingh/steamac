#!/bin/bash
# steamac: ExecStartPre of steam.service (Steam is not running): Steam > Settings >
# Downloads > "Shader Pre-Caching" and "Allow background processing of Vulkan
# shaders" start off in the VM.
#
# Under Venus every pipeline Steam's fossilize_replay processes is compiled by
# Metal on the Mac (about 0.1 s each, cold). Steam processes again after every
# shader download for a game (popular games get new ones almost daily) and for
# every game after a launcher update that changes MoltenVK (the Venus driver
# identity is derived from MoltenVK's pipelineCacheUUID), and the launch waits
# on "Processing Vulkan shaders". The downloaded pipelines are recorded by
# other players' GPUs, and almost none of them are pipelines DXVK creates on
# MoltenVK. Pipelines a game compiles itself stay in the Mac's Metal shader cache
# without any processing.
#
# Applied once per Steam installation (marker next to config.vdf), and only
# where config.vdf holds no value yet: a choice made in Steam's settings stays.
# Before Steam's first start there is no config.vdf: a minimal one is created,
# which Steam reads and fills in.
set -euo pipefail

config=${HOME}/.local/share/Steam/config/config.vdf
marker=${config%/*}/steamac-shader-defaults
[[ ! -e $marker ]] || exit 0

current() {
    if [[ -s $config ]]; then
        cat "$config"
    else
        printf '"InstallConfigStore"\n{\n\t"Software"\n\t{\n\t\t"Valve"\n\t\t{\n\t\t\t"Steam"\n\t\t\t{\n\t\t\t}\n\t\t}\n\t}\n}\n'
    fi
}

mkdir -p "${config%/*}"
tmp=$(mktemp "$config.XXXXXX")
trap 'rm -f "$tmp"' EXIT
# Adds the missing values to InstallConfigStore/Software/Valve/Steam/ShaderCacheManager
# (creating the block if needed). Exit 3: both values present; 4: no Steam section.
status=0
current | LC_ALL=C awk '
BEGIN { RS = "\001"; steam = "installconfigstore/software/valve/steam"; scm = steam "/shadercachemanager" }
{ text = text $0 }
END {
    n = length(text); d = 0; path = ""; want_key = 1; key = ""; scm_at = 0; steam_end = 0
    for (i = 1; i <= n; i++) {
        c = substr(text, i, 1)
        if (c == "\"") {
            for (j = i + 1; j <= n; j++) {
                c = substr(text, j, 1)
                if (c == "\\") j++
                else if (c == "\"") break
            }
            s = tolower(substr(text, i + 1, j - i - 1)); i = j
            if (want_key) { key = s; want_key = 0 }
            else { if (path == scm) seen[key] = 1; want_key = 1 }
        } else if (c == "{") {
            p[++d] = key; path = d == 1 ? key : path "/" key; want_key = 1
            if (path == scm) scm_at = i
        } else if (c == "}" && d > 0) {
            if (path == steam) steam_end = i
            path = d == 1 ? "" : substr(path, 1, length(path) - length(p[d]) - 1); d--; want_key = 1
        }
    }
    if (!scm_at && !steam_end) exit 4
    t4 = "\t\t\t\t"; t5 = t4 "\t"; add = ""
    if (!("disableshadercache" in seen)) add = add t5 "\"DisableShaderCache\"\t\t\"1\"\n"
    if (!("enableshaderbackgroundprocessing" in seen)) add = add t5 "\"EnableShaderBackgroundProcessing\"\t\t\"0\"\n"
    if (add == "") exit 3
    if (scm_at) {
        pos = scm_at; add = "\n" substr(add, 1, length(add) - 1)
    } else {
        for (pos = steam_end - 1; pos > 0 && substr(text, pos, 1) != "\n"; pos--) ;
        add = t4 "\"ShaderCacheManager\"\n" t4 "{\n" add t4 "}\n"
        if (pos == 0) { pos = steam_end - 1; add = "\n" add }
    }
    printf "%s%s%s", substr(text, 1, pos), add, substr(text, pos + 1)
}' > "$tmp" || status=$?
case $status in
    0)
        if [[ -e $config ]]; then chmod --reference="$config" "$tmp"; else chmod 0644 "$tmp"; fi
        mv -f "$tmp" "$config"
        echo 'steam-shader-defaults: Shader Pre-Caching and background Vulkan shader processing off (config.vdf)' >&2 ;;
    3) echo 'steam-shader-defaults: Shader Pre-Caching already set in config.vdf, leaving it' >&2 ;;
    4) echo "steam-shader-defaults: no Steam section in $config yet, leaving it" >&2; exit 0 ;;
    *) echo "steam-shader-defaults: awk failed (status $status), leaving $config" >&2; exit 0 ;;
esac
: > "$marker"
