From 8bab657d825d9f27251e584a925cc085a7714c4e Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sun, 4 Oct 2026 12:00:00 +0000
Subject: [PATCH 15/15] virtio/gpu: report GPU activity counters
 (krun_gpu_get_activity)

Add krun_gpu_get_activity(ctx, &ctrl_cmds, &ring_cmds) so a host can tell
whether the guest is still sending GPU work (the steamac launcher shows a
"still working" indicator when it is not).

ctrl_cmds counts the control-queue commands the GPU worker takes (cursor
queue excluded), with a relaxed atomic in the DisplayControl that
krun_start_enter registers per running context (krun_display_resize's
registry). ring_cmds is virglrenderer's count of dispatched Venus commands
(virgl_steamac_cmd_count, steamac virglrenderer patch 0009), looked up once
with dlsym: Venus rings run in this process and make progress without new
virtio-gpu commands. Without that symbol ring_cmds is 0 and the call
returns -ENOTSUP (ctrl_cmds is still filled in).
---
 include/libkrun.h                     | 23 ++++++++++
 src/devices/src/virtio/gpu/display.rs | 23 ++++++++++
 src/devices/src/virtio/gpu/worker.rs  |  1 +
 src/libkrun/src/lib.rs                | 62 +++++++++++++++++++++++++++
 4 files changed, 109 insertions(+)

diff --git a/include/libkrun.h b/include/libkrun.h
index 0369d6b..e9c9c3a 100644
--- a/include/libkrun.h
+++ b/include/libkrun.h
@@ -762,6 +762,29 @@ int32_t krun_display_set_physical_size(uint32_t ctx_id, uint32_t display_id, uin
 int32_t krun_display_resize(uint32_t ctx_id, uint32_t display_id, uint32_t width, uint32_t height,
                             uint16_t width_mm, uint16_t height_mm);
 
+/**
+ * Read the GPU activity counters of a running VM (any thread, cheap: two relaxed loads).
+ * Both are running totals (ring commands count every context of the process); a host
+ * compares two readings to tell whether the guest sent any GPU work in between.
+ *
+ * Arguments:
+ *  "ctx_id"    - the configuration context ID of a VM in krun_start_enter().
+ *  "ctrl_cmds" - (may be NULL) virtio-gpu control-queue commands taken by the GPU worker
+ *                (SUBMIT_3D, RESOURCE_FLUSH, SET_SCANOUT*, transfers, ...; the cursor
+ *                queue is not counted).
+ *  "ring_cmds" - (may be NULL) Venus commands virglrenderer dispatched, from its in-process
+ *                rings and from SUBMIT_3D buffers (a guest feeding only its Venus rings makes
+ *                progress without control-queue commands). 0 if virglrenderer does not
+ *                export virgl_steamac_cmd_count().
+ *
+ * Returns:
+ *  Zero on success, or a negative error number:
+ *  -ENODEV  no such running context, or the context has no virtio-gpu
+ *  -ENOTSUP libkrun was built without GPU support, or virglrenderer has no command counter
+ *           ("ctrl_cmds" is still valid then)
+ */
+int32_t krun_gpu_get_activity(uint32_t ctx_id, uint64_t *ctrl_cmds, uint64_t *ring_cmds);
+
 /**
  * Configure refresh rate for a display
  *
