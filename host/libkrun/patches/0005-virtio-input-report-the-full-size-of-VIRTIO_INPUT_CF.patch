From 177f2037e42a22a65305befd042b9453be478b1c Mon Sep 17 00:00:00 2001
From: Willie Abrams <willie@pobox.com>
Date: Mon, 28 Sep 2026 09:59:12 -0500
Subject: [PATCH 5/9] virtio/input: report the full size of
 VIRTIO_INPUT_CFG_ABS_INFO

The ABS_INFO reply set the config size to size_of::<InputDeviceIds>()
(8 bytes) instead of size_of::<InputAbsInfo>() (20 bytes). The virtio
spec defines size as the number of bytes of the returned payload,
which for ABS_INFO is struct virtio_input_absinfo. The Linux driver
reads all five fields regardless of size, so this doesn't change what
Linux sees, but a driver that honors size would only read min and max.

Assisted-by: Claude Code: claude-opus-5-5
Signed-off-by: Willie Abrams <willie@pobox.com>
---
 src/devices/src/virtio/input/device.rs | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/devices/src/virtio/input/device.rs b/src/devices/src/virtio/input/device.rs
index fc6b958..963748e 100644
--- a/src/devices/src/virtio/input/device.rs
+++ b/src/devices/src/virtio/input/device.rs
@@ -78,7 +78,7 @@ impl InputConfig {
             }
             config_select::VIRTIO_INPUT_CFG_ABS_INFO => cfg
                 .query_abs_info(subsel, unsafe { &mut self.repr.payload.abs })
-                .map(|_| size_of::<InputDeviceIds>() as u8),
+                .map(|_| size_of::<InputAbsInfo>() as u8),
             select => {
                 error!("Invalid config selection select = {select}");
                 self.invalidate();
@@ -348,6 +348,10 @@ mod tests {
 
         assert_eq!(config.select(), config_select::VIRTIO_INPUT_CFG_ABS_INFO);
         assert_eq!(config.subsel(), ABS_X);
+        assert_eq!(
+            unsafe { config.repr.size } as usize,
+            size_of::<InputAbsInfo>()
+        );
         let abs = unsafe { config.repr.payload.abs };
         assert_eq!(abs.max, ABS_X_INFO.max);
     }
