From 305846360ca2803cae0247e1cae7e69e0c56b787 Mon Sep 17 00:00:00 2001
From: Willie Abrams <willie@pobox.com>
Date: Mon, 28 Sep 2026 09:58:40 -0500
Subject: [PATCH 04/10] virtio/input: keep select and subsel when a config
 query fails

The Linux virtio-input driver sets select and subsel with two separate
config writes. The first write pairs the new select with the subsel
left over from the previous query, which often names something the
device doesn't have. When that query failed, update_select() called
invalidate(), which reset select to VIRTIO_INPUT_CFG_UNSET. The subsel
write that follows was then applied to the unset select, so the query
the driver asked for never ran.

For a tablet this meant VIRTIO_INPUT_CFG_ABS_INFO for ABS_X always
came back empty: the driver reads the absolute axes right after the
EV_BITS queries, so the select write first asked for ABS_INFO of the
axis numbered by the stale event type, and the ABS_X subsel write that
followed queried nothing. The guest saw ABS_X with min == max == 0,
and libinput rejected the device ("kernel bug: device has min == max
on ABS_X"). The remaining axes were unaffected, because by then the
previous query had left ABS_INFO in select.

On failure, keep select and subsel and report size 0, so the next
write completes the intended pair. Log at debug level, since this
failure is part of the normal sequence.

Found running a Fedora 44 Workstation guest with GNOME on
krunkit/libkrun on macOS.

Assisted-by: Claude Code: claude-opus-5-5
Signed-off-by: Willie Abrams <willie@pobox.com>
---
 src/devices/src/virtio/input/device.rs | 95 +++++++++++++++++++++++++-
 1 file changed, 93 insertions(+), 2 deletions(-)

diff --git a/src/devices/src/virtio/input/device.rs b/src/devices/src/virtio/input/device.rs
index c62a1c6..fc6b958 100644
--- a/src/devices/src/virtio/input/device.rs
+++ b/src/devices/src/virtio/input/device.rs
@@ -92,9 +92,14 @@ impl InputConfig {
                 self.repr.select = select;
                 self.repr.subsel = subsel;
             }
+            // The driver writes select and subsel separately, so a failed
+            // query can pair a new select with a stale subsel. Keep both, so
+            // the write that follows queries the intended pair.
             Err(e) => {
-                error!("Failed to query config select={select}, subsel={subsel}: {e:?}");
-                self.invalidate();
+                debug!("Failed to query config select={select}, subsel={subsel}: {e:?}");
+                self.repr.size = 0;
+                self.repr.select = select;
+                self.repr.subsel = subsel;
             }
         };
     }
@@ -261,3 +266,89 @@ impl VirtioDevice for Input {
         true
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use krun_input::{InputBackendError, IntoInputConfig, ObjectNew};
+
+    /// A tablet with a single absolute axis, ABS_X.
+    struct Tablet;
+
+    const ABS_X: u8 = 0x00;
+    const ABS_X_INFO: InputAbsInfo = InputAbsInfo {
+        min: 0,
+        max: 1920,
+        fuzz: 1,
+        flat: 2,
+        res: 3,
+    };
+
+    impl ObjectNew<()> for Tablet {
+        fn new(_userdata: Option<&()>) -> Self {
+            Tablet
+        }
+    }
+
+    impl InputQueryConfig for Tablet {
+        fn query_device_name(&self, _name_buf: &mut [u8]) -> Result<u8, InputBackendError> {
+            Ok(0)
+        }
+
+        fn query_serial_name(&self, _name_buf: &mut [u8]) -> Result<u8, InputBackendError> {
+            Ok(0)
+        }
+
+        fn query_device_ids(&self, _ids: &mut InputDeviceIds) -> Result<(), InputBackendError> {
+            Ok(())
+        }
+
+        fn query_event_capabilities(
+            &self,
+            _event_type: u8,
+            _bitmap_buf: &mut [u8],
+        ) -> Result<u8, InputBackendError> {
+            Ok(0)
+        }
+
+        fn query_abs_info(
+            &self,
+            abs_axis: u8,
+            abs_info: &mut InputAbsInfo,
+        ) -> Result<(), InputBackendError> {
+            if abs_axis != ABS_X {
+                return Err(InputBackendError::InvalidParam);
+            }
+            *abs_info = ABS_X_INFO;
+            Ok(())
+        }
+
+        fn query_properties(&self, _properties: &mut [u8]) -> Result<u8, InputBackendError> {
+            Ok(0)
+        }
+    }
+
+    // The Linux driver writes select and subsel separately. Querying ABS_X
+    // right after an EV_BITS query first pairs ABS_INFO with the stale
+    // event type in subsel, an axis the device doesn't have.
+    #[test]
+    fn test_abs_info_after_stale_subsel() {
+        let backend = <Tablet as IntoInputConfig<()>>::into_input_config(None);
+        let instance = backend.create_instance().unwrap();
+        let mut config = InputConfig::new();
+
+        config.update_select(&instance, config_select::VIRTIO_INPUT_CFG_EV_BITS, 0x03);
+        config.update_select(
+            &instance,
+            config_select::VIRTIO_INPUT_CFG_ABS_INFO,
+            config.subsel(),
+        );
+        assert_eq!(unsafe { config.repr.size }, 0);
+        config.update_select(&instance, config.select(), ABS_X);
+
+        assert_eq!(config.select(), config_select::VIRTIO_INPUT_CFG_ABS_INFO);
+        assert_eq!(config.subsel(), ABS_X);
+        let abs = unsafe { config.repr.payload.abs };
+        assert_eq!(abs.max, ABS_X_INFO.max);
+    }
+}
