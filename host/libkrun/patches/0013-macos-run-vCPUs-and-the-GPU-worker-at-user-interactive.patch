From: steamac <steamac@local>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] macos: run vCPUs and the GPU worker at user-interactive QoS

macOS threads start at the default QoS whatever their creator runs at
(QoS is not inherited through pthread_create), so the vCPU threads and the
virtio-gpu worker ran at the default class and priority next to every other
default-QoS thread on the host.  They are on the guest's frame path: run them
at QOS_CLASS_USER_INTERACTIVE like a game's render threads.
---
diff --git a/src/utils/src/macos/mod.rs b/src/utils/src/macos/mod.rs
--- a/src/utils/src/macos/mod.rs
+++ b/src/utils/src/macos/mod.rs
@@ -1,2 +1,10 @@
 pub mod epoll;
 pub mod eventfd;
+
+/// Run the calling thread at QOS_CLASS_USER_INTERACTIVE. macOS threads start at the
+/// default QoS whatever their creator runs at; the vCPUs and the GPU worker are on the
+/// guest's frame path and should get P-cores and priority like a game's threads.
+pub fn set_thread_qos_user_interactive() {
+    // SAFETY: only changes the calling thread's scheduling class.
+    unsafe { libc::pthread_set_qos_class_self_np(libc::qos_class_t::QOS_CLASS_USER_INTERACTIVE, 0) };
+}
diff --git a/src/vmm/src/macos/vstate.rs b/src/vmm/src/macos/vstate.rs
--- a/src/vmm/src/macos/vstate.rs
+++ b/src/vmm/src/macos/vstate.rs
@@ -339,6 +339,7 @@
         let vcpu_thread = thread::Builder::new()
             .name(format!("fc_vcpu {}", self.cpu_index()))
             .spawn(move || {
+                utils::macos::set_thread_qos_user_interactive();
                 self.init_thread_local_data()
                     .expect("Cannot cleanly initialize vcpu TLS.");
 
diff --git a/src/devices/src/virtio/gpu/worker.rs b/src/devices/src/virtio/gpu/worker.rs
--- a/src/devices/src/virtio/gpu/worker.rs
+++ b/src/devices/src/virtio/gpu/worker.rs
@@ -130,6 +130,8 @@
     }
 
     fn work(mut self) {
+        #[cfg(target_os = "macos")]
+        utils::macos::set_thread_qos_user_interactive();
         let mut virtio_gpu = VirtioGpu::new(
             self.mem.clone(),
             self.control_queue.clone(),
