From 7636ce2aa0112ca207487c0bf3e6d94f470460a1 Mon Sep 17 00:00:00 2001
From: steamac <steamac@local>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] vkr: keep a placeholder for pipelines the host fails to
 create

Venus creates pipelines asynchronously: the guest uses its handles before the
host has created anything, and never learns about a host failure.  The host
dropped failed pipelines (vkr_pipeline_add_array frees them; the generated
create_array even drops every pipeline when the creation as a whole fails,
and leaks the ones the driver did create), so the guest's next
vkCmdBindPipeline, vkDestroyPipeline or derivative creation with that id
failed the object lookup, the decoder went fatal and the whole context was
killed: a game dies because MoltenVK cannot compile one pipeline.

Add every pipeline of a creation call on its own.  One the driver failed to
create becomes a placeholder vkr_pipeline with a VK_NULL_HANDLE driver
handle, logged once ("pipeline N creation failed on host; draws using it will
be skipped"), unless the guest waits for the result
(FAIL_ON_PIPELINE_COMPILE_REQUIRED / EARLY_RETURN_ON_FAILURE): then it gets
the failure in the reply as before and no placeholder is kept.  The
pipelines the driver did create are kept even if the call failed.

Binding a placeholder binds VK_NULL_HANDLE, with which MoltenVK skips draws
and dispatches until a valid pipeline is bound; destroying it frees just the
object; the ray tracing queries refuse it.  vkCmdBindPipeline still treats
id 0 (the guest binding VK_NULL_HANDLE itself) as fatal.
---
 src/venus/vkr_command_buffer.c |  10 ++-
 src/venus/vkr_pipeline.c       | 133 +++++++++++++++++++++++++++------
 2 files changed, 115 insertions(+), 28 deletions(-)

diff --git a/src/venus/vkr_command_buffer.c b/src/venus/vkr_command_buffer.c
index 3e16ce48..2f140b29 100644
--- a/src/venus/vkr_command_buffer.c
+++ b/src/venus/vkr_command_buffer.c
@@ -145,10 +145,12 @@ static void
 vkr_dispatch_vkCmdBindPipeline(struct vn_dispatch_context *dispatch,
                                struct vn_command_vkCmdBindPipeline *args)
 {
-   /* An unknown pipeline id already failed the lookup, but VK_NULL_HANDLE
-    * decodes to no object without an error.  The guest gets there after a
-    * pipeline creation failed (vkr_pipeline_add_array drops the object), and
-    * the driver must not see it: MoltenVK dereferences the pipeline.
+   /* An unknown pipeline id fails the object lookup and sets the decoder
+    * fatal.  A pipeline whose creation failed on the host is a placeholder
+    * (see vkr_pipeline_add): its driver handle is VK_NULL_HANDLE, and the
+    * driver skips draws while it is bound.  Id 0, though, decodes to no
+    * object without an error: the guest bound VK_NULL_HANDLE itself, which is
+    * invalid usage.
     */
    if (!args->pipeline) {
       vkr_log("vkCmdBindPipeline with VK_NULL_HANDLE pipeline");
diff --git a/src/venus/vkr_pipeline.c b/src/venus/vkr_pipeline.c
index 76709b9b..617a54fc 100644
--- a/src/venus/vkr_pipeline.c
+++ b/src/venus/vkr_pipeline.c
@@ -105,19 +105,97 @@ vkr_dispatch_vkMergePipelineCaches(UNUSED struct vn_dispatch_context *dispatch,
                                        args->pSrcCaches);
 }
 
+/* Flags with which the guest driver waits for the result of a pipeline
+ * creation.  Otherwise Venus creates pipelines asynchronously: the guest
+ * already uses the handles before the host has created anything.
+ */
+#define VKR_PIPELINE_CREATE_GUEST_WAITS                                              \
+   (VK_PIPELINE_CREATE_2_FAIL_ON_PIPELINE_COMPILE_REQUIRED_BIT |                     \
+    VK_PIPELINE_CREATE_2_EARLY_RETURN_ON_FAILURE_BIT)
+
+static bool
+vkr_pipeline_guest_waits(const void *pnext, VkPipelineCreateFlags flags)
+{
+   const VkPipelineCreateFlags2CreateInfo *flags2 =
+      vkr_find_struct(pnext, VK_STRUCTURE_TYPE_PIPELINE_CREATE_FLAGS_2_CREATE_INFO);
+   return (flags2 ? flags2->flags : flags) & VKR_PIPELINE_CREATE_GUEST_WAITS;
+}
+
+/* Add the vkr_pipeline for one created pipeline, whatever the result of the
+ * creation as a whole (per pipeline, a failure is a VK_NULL_HANDLE).
+ *
+ * A pipeline that failed on the host is still added, as a placeholder with a
+ * VK_NULL_HANDLE driver handle, unless the guest waits for the result: an
+ * asynchronously created pipeline is in use in the guest already, and a
+ * lookup failure on its id would kill the whole context.  Binding the
+ * placeholder binds VK_NULL_HANDLE, with which the driver skips the draws
+ * (MoltenVK does), and destroying it frees just the object.
+ *
+ * The reply, if any, reports the failure with VK_NULL_HANDLE.  A guest that
+ * waits only on a secondary ring (no flag says so) drops its pipeline then,
+ * and the placeholder lives until the device is destroyed.
+ */
+static void
+vkr_pipeline_add(struct vkr_context *ctx,
+                 struct vkr_device *dev,
+                 struct vkr_pipeline *obj,
+                 VkPipeline handle,
+                 VkPipeline *args_pipeline,
+                 bool guest_waits)
+{
+   obj->base.handle.pipeline = handle;
+   if (handle == VK_NULL_HANDLE) {
+      *args_pipeline = VK_NULL_HANDLE;
+      if (guest_waits) {
+         free(obj);
+         return;
+      }
+      vkr_log("pipeline %" PRIu64 " creation failed on host; draws using it will be "
+              "skipped",
+              obj->base.id);
+   }
+
+   vkr_device_add_object(ctx, dev, &obj->base);
+}
+
+static inline bool
+vkr_pipeline_is_placeholder(VkPipeline pipeline)
+{
+   const struct vkr_pipeline *obj = vkr_pipeline_from_handle(pipeline);
+   return obj && obj->base.handle.pipeline == VK_NULL_HANDLE;
+}
+
+/* The generated vkr_*_pipeline_create_array drops every vkr_pipeline when the
+ * creation as a whole fails, although the driver still creates the pipelines
+ * it can, and vkr_pipeline_add_array drops the failed ones.  These add each
+ * pipeline with vkr_pipeline_add instead.
+ */
+#define VKR_PIPELINE_CREATE(ctx, args, type)                                         \
+   do {                                                                              \
+      struct vkr_device *_dev = vkr_device_from_handle((args)->device);              \
+      struct object_array _arr;                                                      \
+      if (vkr_##type##_pipeline_init_array((ctx), (args), &_arr) != VK_SUCCESS)      \
+         break;                                                                      \
+      /* failed pipelines must be VK_NULL_HANDLE; do not trust the driver */        \
+      memset(_arr.handle_storage, 0, sizeof(VkPipeline) * _arr.count);               \
+      vkr_##type##_pipeline_create_driver_handles((ctx), (args), &_arr);             \
+      for (uint32_t _i = 0; _i < _arr.count; _i++) {                                 \
+         const bool _waits = vkr_pipeline_guest_waits((args)->pCreateInfos[_i].pNext, \
+                                                      (args)->pCreateInfos[_i].flags); \
+         vkr_pipeline_add((ctx), _dev, _arr.objects[_i],                             \
+                          ((VkPipeline *)_arr.handle_storage)[_i],                   \
+                          &(args)->pPipelines[_i], _waits);                          \
+      }                                                                              \
+      _arr.objects_stolen = true;                                                    \
+      object_array_fini(&_arr);                                                      \
+   } while (0)
+
 static void
 vkr_dispatch_vkCreateGraphicsPipelines(struct vn_dispatch_context *dispatch,
                                        struct vn_command_vkCreateGraphicsPipelines *args)
 {
    TRACE_FUNC();
-   struct vkr_context *ctx = dispatch->data;
-   struct vkr_device *dev = vkr_device_from_handle(args->device);
-   struct object_array arr;
-
-   if (vkr_graphics_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
-      return;
-
-   vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
+   VKR_PIPELINE_CREATE(dispatch->data, args, graphics);
 }
 
 static void
@@ -125,20 +203,19 @@ vkr_dispatch_vkCreateComputePipelines(struct vn_dispatch_context *dispatch,
                                       struct vn_command_vkCreateComputePipelines *args)
 {
    TRACE_FUNC();
-   struct vkr_context *ctx = dispatch->data;
-   struct vkr_device *dev = vkr_device_from_handle(args->device);
-   struct object_array arr;
-
-   if (vkr_compute_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
-      return;
-
-   vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
+   VKR_PIPELINE_CREATE(dispatch->data, args, compute);
 }
 
 static void
 vkr_dispatch_vkDestroyPipeline(struct vn_dispatch_context *dispatch,
                                struct vn_command_vkDestroyPipeline *args)
 {
+   if (vkr_pipeline_is_placeholder(args->pipeline)) {
+      vkr_device_remove_object(dispatch->data, vkr_device_from_handle(args->device),
+                               &vkr_pipeline_from_handle(args->pipeline)->base);
+      return;
+   }
+
    vkr_pipeline_destroy_and_remove(dispatch->data, args);
 }
 
@@ -148,14 +225,7 @@ vkr_dispatch_vkCreateRayTracingPipelinesKHR(
    struct vn_command_vkCreateRayTracingPipelinesKHR *args)
 {
    TRACE_FUNC();
-   struct vkr_context *ctx = dispatch->data;
-   struct vkr_device *dev = vkr_device_from_handle(args->device);
-   struct object_array arr;
-
-   if (vkr_ray_tracing_pipeline_create_array(ctx, args, &arr) < VK_SUCCESS)
-      return;
-
-   vkr_pipeline_add_array(ctx, dev, &arr, args->pPipelines);
+   VKR_PIPELINE_CREATE(dispatch->data, args, ray_tracing);
 }
 
 static void
@@ -166,6 +236,11 @@ vkr_dispatch_vkGetRayTracingCaptureReplayShaderGroupHandlesKHR(
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (vkr_pipeline_is_placeholder(args->pipeline)) {
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vn_replace_vkGetRayTracingCaptureReplayShaderGroupHandlesKHR_args_handle(args);
    args->ret = vk->GetRayTracingCaptureReplayShaderGroupHandlesKHR(
       args->device, args->pipeline, args->firstGroup, args->groupCount, args->dataSize,
@@ -180,6 +255,11 @@ vkr_dispatch_vkGetRayTracingShaderGroupHandlesKHR(
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (vkr_pipeline_is_placeholder(args->pipeline)) {
+      args->ret = VK_ERROR_UNKNOWN;
+      return;
+   }
+
    vn_replace_vkGetRayTracingShaderGroupHandlesKHR_args_handle(args);
    args->ret = vk->GetRayTracingShaderGroupHandlesKHR(args->device, args->pipeline,
                                                       args->firstGroup, args->groupCount,
@@ -194,6 +274,11 @@ vkr_dispatch_vkGetRayTracingShaderGroupStackSizeKHR(
    struct vkr_device *dev = vkr_device_from_handle(args->device);
    struct vn_device_proc_table *vk = &dev->proc_table;
 
+   if (vkr_pipeline_is_placeholder(args->pipeline)) {
+      args->ret = 0;
+      return;
+   }
+
    vn_replace_vkGetRayTracingShaderGroupStackSizeKHR_args_handle(args);
    args->ret = vk->GetRayTracingShaderGroupStackSizeKHR(args->device, args->pipeline,
                                                         args->group, args->groupShader);
