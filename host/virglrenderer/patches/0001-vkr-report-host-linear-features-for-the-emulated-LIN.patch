From: steamac <steamac@local>
Subject: [PATCH] vkr: report host linear features for the emulated LINEAR modifier

The emulated VK_EXT_image_drm_format_modifier offers one modifier, LINEAR, and
creates such images as host VK_IMAGE_TILING_LINEAR images. Its modifier
properties claimed a fixed SAMPLED | FILTER_LINEAR | COLOR_ATTACHMENT, so
gamescope (DRMBackend pick_plane_format, which needs SAMPLED | STORAGE |
TRANSFER_SRC) found no scanout format even though MoltenVK's linear tiling
supports all of them (linearTilingFeatures 0x8000dd83 for B8G8R8A8_UNORM on
an M4 Max).

- Report the host's linearTilingFeatures as the LINEAR modifier's tiling
  features, for VkDrmFormatModifierPropertiesListEXT and (from
  VkFormatProperties3) VkDrmFormatModifierPropertiesList2EXT; no modifier
  when the format has no linear features.
- Image format queries for LINEAR no longer drop COLOR/INPUT_ATTACHMENT from
  the usage: the host answers for its linear tiling, which supports
  attachments on Apple GPUs (MoltenVK renderLinearTextures) and refuses them
  where it does not, instead of us claiming support we did not check.
- Stop writing a VkDrmFormatModifierPropertiesListEXT into the
  VkImageFormatProperties2 chain, where it is not a valid structure.
- An explicit LINEAR plane layout (an imported dma-buf) whose offset or row
  pitch differs from the host linear image's is refused with
  VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT rather than read with
  the wrong pitch.
---
diff --git a/src/venus/vkr_image.c b/src/venus/vkr_image.c
index c9d9964..f81906f 100644
--- a/src/venus/vkr_image.c
+++ b/src/venus/vkr_image.c
@@ -36,6 +36,38 @@ vkr_image_fix_drm_format(struct vkr_device *dev,
 
    if (drm_format_info && drm_format_info->drmFormatModifier == DRM_FORMAT_MOD_LINEAR) {
       pCreateInfo->tiling = VK_IMAGE_TILING_LINEAR;
+
+      /* An imported linear buffer (a dma-buf from another device or process) comes
+       * with its own plane layout, but the host decides the layout of a linear
+       * image itself.  Refuse layouts it would not reproduce instead of reading the
+       * buffer with the wrong pitch.
+       */
+      struct vn_device_proc_table *vk = &dev->proc_table;
+      if (drm_format_info->drmFormatModifierPlaneCount != 1)
+         return VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT;
+      if (vk->GetDeviceImageSubresourceLayout) {
+         const VkSubresourceLayout *want = &drm_format_info->pPlaneLayouts[0];
+         const VkImageSubresource2 subres = {
+            .sType = VK_STRUCTURE_TYPE_IMAGE_SUBRESOURCE_2,
+            .imageSubresource = { .aspectMask = VK_IMAGE_ASPECT_COLOR_BIT },
+         };
+         const VkDeviceImageSubresourceInfo info = {
+            .sType = VK_STRUCTURE_TYPE_DEVICE_IMAGE_SUBRESOURCE_INFO,
+            .pCreateInfo = pCreateInfo,
+            .pSubresource = &subres,
+         };
+         VkSubresourceLayout2 have = { .sType = VK_STRUCTURE_TYPE_SUBRESOURCE_LAYOUT_2 };
+         vk->GetDeviceImageSubresourceLayout(dev->base.handle.device, &info, &have);
+         if (want->offset != have.subresourceLayout.offset ||
+             want->rowPitch != have.subresourceLayout.rowPitch) {
+            vkr_log("linear plane layout offset %" PRIu64 " pitch %" PRIu64
+                    " differs from the host's offset %" PRIu64 " pitch %" PRIu64,
+                    (uint64_t)want->offset, (uint64_t)want->rowPitch,
+                    (uint64_t)have.subresourceLayout.offset,
+                    (uint64_t)have.subresourceLayout.rowPitch);
+            return VK_ERROR_INVALID_DRM_FORMAT_MODIFIER_PLANE_LAYOUT_EXT;
+         }
+      }
       return VK_SUCCESS;
    }
 
diff --git a/src/venus/vkr_physical_device.c b/src/venus/vkr_physical_device.c
index 774705e..88dceb7 100644
--- a/src/venus/vkr_physical_device.c
+++ b/src/venus/vkr_physical_device.c
@@ -395,19 +395,37 @@ vkr_physical_device_init_queue_family_properties(struct vkr_physical_device *phy
    physical_dev->queue_family_properties = props;
 }
 
+/* The only modifier emulated is DRM_FORMAT_MOD_LINEAR, and an image created with it is a
+ * host VK_IMAGE_TILING_LINEAR image (vkr_image_fix_drm_format), so it supports exactly the
+ * host's linear tiling features.  Report those: a compositor such as gamescope picks its
+ * scanout formats by the features of their modifiers (sampled, storage, transfer src).
+ */
 static void
-vkr_physical_device_emulate_drm_props(VkDrmFormatModifierPropertiesListEXT *drm_props_list)
+vkr_physical_device_emulate_drm_props(VkDrmFormatModifierPropertiesListEXT *drm_props_list,
+                                      VkFormatFeatureFlags linear_features)
 {
-    drm_props_list->drmFormatModifierCount = 1;
-    if (drm_props_list->pDrmFormatModifierProperties) {
+   drm_props_list->drmFormatModifierCount = linear_features ? 1 : 0;
+   if (linear_features && drm_props_list->pDrmFormatModifierProperties) {
       drm_props_list->pDrmFormatModifierProperties[0] = (VkDrmFormatModifierPropertiesEXT){
          .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
          .drmFormatModifierPlaneCount = 1,
-         .drmFormatModifierTilingFeatures = VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT |
-                                            VK_FORMAT_FEATURE_SAMPLED_IMAGE_FILTER_LINEAR_BIT |
-                                            VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT,
+         .drmFormatModifierTilingFeatures = linear_features,
+      };
+   }
+}
+
+static void
+vkr_physical_device_emulate_drm_props2(VkDrmFormatModifierPropertiesList2EXT *drm_props_list,
+                                       VkFormatFeatureFlags2 linear_features)
+{
+   drm_props_list->drmFormatModifierCount = linear_features ? 1 : 0;
+   if (linear_features && drm_props_list->pDrmFormatModifierProperties) {
+      drm_props_list->pDrmFormatModifierProperties[0] = (VkDrmFormatModifierProperties2EXT){
+         .drmFormatModifier = DRM_FORMAT_MOD_LINEAR,
+         .drmFormatModifierPlaneCount = 1,
+         .drmFormatModifierTilingFeatures = linear_features,
       };
-    };
+   }
 }
 
 static void
@@ -771,10 +789,32 @@ vkr_dispatch_vkGetPhysicalDeviceFormatProperties2(
 
    /* emulate support for drm format modifiers */
    if (!physical_dev->EXT_image_drm_format_modifier) {
-      VkDrmFormatModifierPropertiesListEXT* drm_props_list =
-         vkr_find_struct(args->pFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT);
+      VkDrmFormatModifierPropertiesListEXT *drm_props_list = vkr_find_struct(
+         args->pFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT);
       if (drm_props_list) {
-         vkr_physical_device_emulate_drm_props(drm_props_list);
+         vkr_physical_device_emulate_drm_props(
+            drm_props_list, args->pFormatProperties->formatProperties.linearTilingFeatures);
+      }
+
+      VkDrmFormatModifierPropertiesList2EXT *drm_props_list2 = vkr_find_struct(
+         args->pFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_2_EXT);
+      if (drm_props_list2) {
+         /* the 64-bit features, from the guest's VkFormatProperties3 if it chained one */
+         VkFormatProperties3 local_props3 = {
+            .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3,
+         };
+         const VkFormatProperties3 *props3 =
+            vkr_find_struct(args->pFormatProperties, VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_3);
+         if (!props3) {
+            VkFormatProperties2 local_props2 = {
+               .sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2,
+               .pNext = &local_props3,
+            };
+            vk->GetPhysicalDeviceFormatProperties2(args->physicalDevice, args->format,
+                                                   &local_props2);
+            props3 = &local_props3;
+         }
+         vkr_physical_device_emulate_drm_props2(drm_props_list2, props3->linearTilingFeatures);
       }
    }
 }
@@ -811,12 +851,11 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2(
          const VkPhysicalDeviceImageDrmFormatModifierInfoEXT *drm_format_mod =
             (const VkPhysicalDeviceImageDrmFormatModifierInfoEXT *)prev_struct->pNext;
          if (drm_format_mod->drmFormatModifier == DRM_FORMAT_MOD_LINEAR) {
-            /* Remove the struct from the list */
+            /* Remove the struct from the list: the image will be a host linear
+             * image, so the host's answer for linear tiling is the answer.
+             */
             prev_struct->pNext = drm_format_mod->pNext;
-            vkr_log("emulating DRM_FORMAT_MOD_LINEAR with VK_IMAGE_TILING_LINEAR");
             pImageFormatInfo->tiling = VK_IMAGE_TILING_LINEAR;
-            pImageFormatInfo->usage &=
-               ~(VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_INPUT_ATTACHMENT_BIT);
          } else {
             vkr_log("only DRM_FORMAT_MOD_LINEAR is supported");
             args->ret = VK_ERROR_FORMAT_NOT_SUPPORTED;
@@ -853,15 +892,6 @@ vkr_dispatch_vkGetPhysicalDeviceImageFormatProperties2(
       if (img_props && args->ret == VK_SUCCESS)
          vkr_emulate_dma_buf_memory_properties(&img_props->externalMemoryProperties);
    }
-
-   /* emulate support for drm format modifiers */
-   if (!physical_dev->EXT_image_drm_format_modifier) {
-      VkDrmFormatModifierPropertiesListEXT* drm_props_list =
-         vkr_find_struct(args->pImageFormatProperties, VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT);
-      if (drm_props_list) {
-         vkr_physical_device_emulate_drm_props(drm_props_list);
-      }
-   }
 }
 
 static void
