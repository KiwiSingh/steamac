From: steamac <steamac@local>
Date: Sun, 4 Oct 2026 00:00:00 +0000
Subject: [PATCH] macos: run virglrenderer threads at user-interactive QoS, never
 renice the process

macOS threads start at the default QoS whatever their creator runs at, so
the Venus ring threads that dispatch the guest's frames (and wait for Metal
shader compiles in MTLCompilerService, which inherits the caller's QoS over
XPC) competed with every other default-QoS thread on the host.  thrd_create
now asks for QOS_CLASS_USER_INTERACTIVE on macOS.

vkr_ring_thread applied the guest thread's nice value (VkRingPriorityInfoMESA)
with setpriority(PRIO_PROCESS, 0), which on Linux renices the calling thread
but on macOS renices the whole VMM process; an unprivileged process can never
lower its nice value again.  One nice-19 guest thread (Steam's fossilize_replay
shader pre-caching) left the VM process at nice 19 for the rest of the boot,
and threads it created later started at a lower priority.  On macOS a positive
guest nice now lowers only that ring thread to QOS_CLASS_UTILITY.
---
diff --git a/src/mesa/compat/c11/threads_posix.h b/src/mesa/compat/c11/threads_posix.h
index 071faf79..e2506b6e 100644
--- a/src/mesa/compat/c11/threads_posix.h
+++ b/src/mesa/compat/c11/threads_posix.h
@@ -35,6 +35,9 @@
 #include <unistd.h>
 #include <sched.h>
 #include <stdint.h> /* for intptr_t */
+#ifdef __APPLE__
+#include <pthread/qos.h>
+#endif
 
 /*
 Configuration macro:
@@ -290,7 +293,21 @@ thrd_create(thrd_t *thr, thrd_start_t func, void *arg)
     if (!pack) return thrd_nomem;
     pack->func = func;
     pack->arg = arg;
-    if (pthread_create(thr, NULL, impl_thrd_routine, pack) != 0) {
+    pthread_attr_t *pattr = NULL;
+#ifdef __APPLE__
+    pthread_attr_t attr;
+    /* macOS threads do not inherit their creator's QoS and start at the default
+     * class. Every virglrenderer thread (Venus rings, queue sync, fences) is on
+     * the guest's frame path and its Metal shader compiles: user-interactive.
+     */
+    if (pthread_attr_init(&attr) == 0) {
+        pthread_attr_set_qos_class_np(&attr, QOS_CLASS_USER_INTERACTIVE, 0);
+        pattr = &attr;
+    }
+#endif
+    int ret = pthread_create(thr, pattr, impl_thrd_routine, pack);
+    if (pattr) pthread_attr_destroy(pattr);
+    if (ret != 0) {
         free(pack);
         return thrd_error;
     }
diff --git a/src/venus/vkr_ring.c b/src/venus/vkr_ring.c
index 0d4899ef..4eb3ba05 100644
--- a/src/venus/vkr_ring.c
+++ b/src/venus/vkr_ring.c
@@ -7,6 +7,9 @@
 
 #include <stdio.h>
 #include <sys/resource.h>
+#ifdef __APPLE__
+#include <pthread/qos.h>
+#endif
 #include <time.h>
 
 #include "vn_protocol_renderer_dispatches.h"
@@ -254,6 +257,17 @@ vkr_ring_thread(void *arg)
 
    snprintf(thread_name, ARRAY_SIZE(thread_name), "vkr-ring-%d", ctx->ctx_id);
    u_thread_setname(thread_name);
+#ifdef __APPLE__
+   /* The priority is the guest thread's nice value. On macOS setpriority(PRIO_PROCESS, 0)
+    * renices the whole VMM process, not this thread, and an unprivileged process can
+    * never lower its nice value again: one nice-19 guest thread (Steam's fossilize_replay
+    * shader pre-caching) left every thread the VMM created afterwards at a low priority.
+    * Map it to this thread's QoS instead: niced guest threads compile and submit at
+    * utility QoS, the rest stay user-interactive (see thrd_create).
+    */
+   if (ring->prio_valid && ring->prio > 0)
+      pthread_set_qos_class_self_np(QOS_CLASS_UTILITY, 0);
+#else
    if (ring->prio_valid && setpriority(PRIO_PROCESS, 0, ring->prio)) {
 #ifdef DEBUG
       /* Currently venus doesn't forward the CAP_SYS_NICE request upon forking, so
@@ -263,6 +277,7 @@ vkr_ring_thread(void *arg)
       vkr_log("failed to set ring thread priority to %d (%d)", ring->prio, errno);
 #endif
    }
+#endif
 
    uint64_t last_submit = vkr_ring_now();
    uint32_t relax_iter = 0;
