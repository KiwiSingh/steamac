@@ -666,15 +666,14 @@ kk_get_image_memory_requirements(struct kk_device *dev, struct kk_image *image,
    struct kk_physical_device *pdev = kk_device_physical(dev);
    uint32_t memory_types = (1 << pdev->mem_type_count) - 1;
 
-   /* Remove non host visible heaps from the types for host image copy in case
-    * of potential issues. This should be removed when we get ReBAR.
-    */
-   if (image->vk.usage & VK_IMAGE_USAGE_HOST_TRANSFER_BIT_EXT) {
-      for (uint32_t i = 0; i < pdev->mem_type_count; i++) {
-         if (!(pdev->mem_types[i].propertyFlags &
-               VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT))
-            memory_types &= ~BITFIELD_BIT(i);
-      }
+   /* Optimal textures need a native MTLHeap. Linear/exportable textures
+    * must stay on the host-pointer memory type that Venus shares with the VMM. */
+   const bool needs_host_pointer = image->vk.tiling != VK_IMAGE_TILING_OPTIMAL;
+   for (uint32_t i = 0; i < pdev->mem_type_count; i++) {
+      const bool host_visible = pdev->mem_types[i].propertyFlags &
+                                VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT;
