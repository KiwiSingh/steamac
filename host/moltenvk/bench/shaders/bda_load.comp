#version 450
// Vector components through a buffer device address: 256 component loads (gathered over the buffer) and
// one component store per invocation, 'p->v[i].y' in MSL. SPIRV-Cross 0019 must keep this form: through a
// scalar pointer ('((device uint*)&p->v[i])[1]', as for SSBO components) it was 5% slower.
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430) buffer data_t {
	uvec4 v[];
};

layout(push_constant) uniform pc_t {
	data_t p;
	uint mask;
};

void main()
{
	uint id = gl_GlobalInvocationID.x;
	uint sum = 0u;
	for (uint k = 0u; k < 256u; k++)
		sum += p.v[(id + k * 4099u) & mask].y;
	p.v[id & mask].w = sum;
}
