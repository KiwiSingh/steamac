#version 450
// 256 gathered texelFetch per invocation from a uniform texel buffer in an argument buffer set (bench.c
// texel_load*). With single texel alignment emulation (MoltenVK 0029) each fetch adds the view's texel offset.
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform utextureBuffer t;
layout(set = 0, binding = 1) buffer out_t { uint o[]; };

layout(push_constant) uniform pc_t {
	uint mask;
};

void main()
{
	uint id = gl_GlobalInvocationID.x;
	uint sum = 0u;
	for (uint k = 0u; k < 256u; k++)
		sum += texelFetch(t, int((id + k * 4099u) & mask)).x;
	o[id & mask] = sum;
}
