; Vertex shader with an unused InstanceIndex in its interface (vkd3d-proton), and
; a builtin declared outside this entry point's interface. Neither becomes a
; wrapped vertex-function argument; the GS object wrapper must not pass them.
OpCapability Shader
OpMemoryModel Logical GLSL450
OpEntryPoint Vertex %main "main" %pos %opos %ocol %position %unused_instance
OpName %main "main"
OpName %unused_instance "unused_instance"
OpName %outside_vertex "outside_vertex"
OpDecorate %pos Location 0
OpDecorate %opos Location 0
OpDecorate %ocol Location 1
OpDecorate %position BuiltIn Position
OpDecorate %unused_instance BuiltIn InstanceIndex
OpDecorate %outside_vertex BuiltIn VertexIndex
%void = OpTypeVoid
%fn = OpTypeFunction %void
%int = OpTypeInt 32 1
%float = OpTypeFloat 32
%v2 = OpTypeVector %float 2
%v4 = OpTypeVector %float 4
%f0 = OpConstant %float 0
%f1 = OpConstant %float 1
%fhalf = OpConstant %float 0.5
%green = OpConstantComposite %v4 %f0 %f1 %f0 %f1
%p_in_int = OpTypePointer Input %int
%p_in_v2 = OpTypePointer Input %v2
%p_out_v4 = OpTypePointer Output %v4
%pos = OpVariable %p_in_v2 Input
%unused_instance = OpVariable %p_in_int Input
%outside_vertex = OpVariable %p_in_int Input
%opos = OpVariable %p_out_v4 Output
%ocol = OpVariable %p_out_v4 Output
%position = OpVariable %p_out_v4 Output
%main = OpFunction %void None %fn
%entry = OpLabel
%p = OpLoad %v2 %pos
%x = OpCompositeExtract %float %p 0
%y = OpCompositeExtract %float %p 1
%p4 = OpCompositeConstruct %v4 %x %y %fhalf %f1
OpStore %position %p4
OpStore %opos %p4
OpStore %ocol %green
OpReturn
OpFunctionEnd
