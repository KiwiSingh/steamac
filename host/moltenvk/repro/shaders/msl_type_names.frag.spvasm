          %5 = OpLabel
         %14 = OpLoad %11 %smpA
         %18 = OpImageSampleImplicitLod %v4float %14 %17
         %26 = OpAccessChain %_ptr_UniformConstant_11 %smpB %int_1
         %27 = OpLoad %11 %26
         %28 = OpImageSampleImplicitLod %v4float %27 %17
         %29 = OpFAdd %v4float %18 %28
               OpStore %c %29
               OpReturn
               OpFunctionEnd
