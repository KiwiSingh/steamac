 #endif
                 } else {
                     MVKRenderSubpass* subpass = cmdEncoder->getSubpass();
@@ -789,7 +864,6 @@ static void encodeGeometryIndirectDraws(MVKCommandEncoder* cmdEncoder, MVKGraphi
 					drawInfo.indexSize = (int)idxSize;
