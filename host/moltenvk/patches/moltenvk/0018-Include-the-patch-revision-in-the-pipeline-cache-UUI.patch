From 6df55708da962734cbc2bce80ac5454e5350221b Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sun, 4 Oct 2026 00:59:15 +0300
Subject: [PATCH 18/20] Include the patch revision in the pipeline cache UUID

The pipeline cache UUID only contained the MoltenVK git revision, the GPU and the argument
buffer mode, so pipeline caches written by a build with other patches on the same MoltenVK
revision (guests keep zink's and DXVK's caches across host updates) were accepted and their
cached MSL, generated by older patches, reused. Add MVK_PATCH_REVISION, generated by the build
into MVKPatchRevision.h from the patch series, as the last 4 bytes.
---
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
index d5386762..3fabf18c 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
@@ -18,6 +18,12 @@
 
 #include "MVKInstance.h"
 #include "MVKDevice.h"
+#if __has_include("MVKPatchRevision.h")
+#	include "MVKPatchRevision.h"		// Generated by the build: #define MVK_PATCH_REVISION
+#endif
+#ifndef MVK_PATCH_REVISION
+#	define MVK_PATCH_REVISION 0
+#endif
 #include "MVKQueue.h"
 #include "MVKSurface.h"
 #include "MVKBuffer.h"
@@ -3299,6 +3305,13 @@ static uint32_t mvkGetEntryProperty(io_registry_entry_t entry, CFStringRef prope
 	mtlFeatures |= _isUsingMetalArgumentBuffers << 0;
 	*(uint32_t*)&_properties.pipelineCacheUUID[uuidComponentOffset] = NSSwapHostIntToBig(mtlFeatures);
 	uuidComponentOffset += sizeof(mtlFeatures);
+
+	// Last 4 bytes: revision of the patches applied on top of the MoltenVK and SPIRV-Cross sources
+	// (generated by the build). Patches change the generated MSL and the cached shader configurations,
+	// so pipeline caches written by a build with other patches must not be used.
+	uint32_t patchRev = MVK_PATCH_REVISION;
+	*(uint32_t*)&_properties.pipelineCacheUUID[uuidComponentOffset] = NSSwapHostIntToBig(patchRev);
+	uuidComponentOffset += sizeof(patchRev);
 }
 
 // Combine OS major (8 bits), OS minor (8 bits), Mac GPU family (8 bits), and
