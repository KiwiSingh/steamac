From 08ec8c07ff55d6e54c42df62d1d5401eff6443c4 Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sat, 3 Oct 2026 23:03:22 +0300
Subject: [PATCH 11/14] Pass vertex buffer strides to the geometry-shader
 object stage

The geometry-shader (mesh) path fetched vertices with the stride compiled into the
shader, ignoring dynamic strides from vkCmdBindVertexBuffers2. zink emulates the
provoking vertex with a geometry shader on every draw and uses dynamic strides with
pipeline stride 0, so everything it drew read vertex 0 and was not rasterized.

DrawInfo gains vertexStrides[] by Metal vertex buffer index: the bound strides when the
pipeline has VK_DYNAMIC_STATE_VERTEX_INPUT_BINDING_STRIDE, else the pipeline's binding
strides. Direct draws fill it on the CPU; the indirect-draw conversion kernel copies it
from its parameters.
---
 MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm      | 22 +++++++++++++++++++
 ...KCommandPipelineStateFactoryShaderSource.h |  3 +++
 MoltenVK/MoltenVK/GPUObjects/MVKPipeline.h    |  3 +++
 MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm   |  1 +
 4 files changed, 29 insertions(+)

diff --git a/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm b/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
index 256cb7c4..8c69894b 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
+++ b/MoltenVK/MoltenVK/Commands/MVKCmdDraw.mm
@@ -167,8 +167,24 @@
 	uint64_t indexBuffer;
 	int32_t baseVertex;      // firstVertex (non-indexed) or vertexOffset (indexed)
 	uint32_t baseInstance;
+	uint32_t vertexStrides[kMVKMaxBufferCount];  // by Metal vertex buffer index
 	uint8_t topoStrip;
 };
+static_assert(kMVKMaxBufferCount == 31, "DrawInfo.vertexStrides must match the SPIRV-Cross object stage");
+
+/* Sets the vertex buffer strides the geometry-shader object stage fetches vertices with: the
+ * strides bound with vkCmdBindVertexBuffers2 when the pipeline has dynamic strides, else the
+ * pipeline's binding strides. */
+static void setGeometryVertexStrides(DrawInfo& drawInfo, MVKCommandEncoder* cmdEncoder, MVKGraphicsPipeline* pipeline) {
+	bool dynamicStride = pipeline->getDynamicStateFlags().has(MVKRenderStateFlag::VertexStride);
+	const auto& vkState = cmdEncoder->getVkGraphics();
+	for (size_t vkIdx : pipeline->getVkVertexBuffers()) {
+		uint32_t mtlIdx = pipeline->getMetalBufferIndexForVertexAttributeBinding((uint32_t)vkIdx);
+		if (mtlIdx >= kMVKMaxBufferCount) { continue; }
+		drawInfo.vertexStrides[mtlIdx] = dynamicStride ? vkState._vertexBuffers[vkIdx].stride
+		                                               : pipeline->getVkVertexBindingStride((uint32_t)vkIdx);
+	}
+}
 
 #if MVK_XCODE_14
 /* Parameters of the compute pass that converts indirect draws for geometry-shader (mesh) pipelines.
@@ -179,6 +195,7 @@
 	uint32_t indexSize;
 	uint32_t vertsPerPrim;
 	uint32_t isStrip;
+	uint32_t vertexStrides[kMVKMaxBufferCount];
 };
 
 /* Returns the vertices per primitive and whether the topology is a strip, or false if the
@@ -219,6 +236,9 @@ static void encodeGeometryIndirectDraws(MVKCommandEncoder* cmdEncoder, MVKGraphi
 		params.indexSize = (uint32_t)mvkMTLIndexTypeSizeInBytes((MTLIndexType)ibb->mtlIndexType);
 		params.indexBuffer = ibb->mtlBuffer.gpuAddress + ibb->offset;
 	}
+	DrawInfo strides = {};
+	setGeometryVertexStrides(strides, cmdEncoder, pipeline);
+	memcpy(params.vertexStrides, strides.vertexStrides, sizeof(params.vertexStrides));
 
 	// Per draw: MTLDispatchThreadgroupsIndirectArguments (mesh threadgroups) and DrawInfo.
 	const VkDeviceSize dispatchSize = sizeof(MTLDispatchThreadgroupsIndirectArguments) * drawCount;
@@ -483,6 +503,7 @@ static void encodeGeometryIndirectDraws(MVKCommandEncoder* cmdEncoder, MVKGraphi
 
 					drawInfo.baseVertex = (int32_t)_firstVertex;
 					drawInfo.baseInstance = _firstInstance;
+					setGeometryVertexStrides(drawInfo, cmdEncoder, pipeline);
 
 					// setObjectBytes copies the struct, so set it once all fields (topoStrip) are known.
 					[cmdEncoder->_mtlRenderEncoder setObjectBytes: &drawInfo length: sizeof(drawInfo) atIndex: pipeline->getDrawInfoBufferIndex()];
@@ -773,6 +794,7 @@ static void encodeGeometryIndirectDraws(MVKCommandEncoder* cmdEncoder, MVKGraphi
 
 					drawInfo.baseVertex = _vertexOffset;
 					drawInfo.baseInstance = _firstInstance;
+					setGeometryVertexStrides(drawInfo, cmdEncoder, pipeline);
 
 					// setObjectBytes copies the struct, so set it once all fields (topoStrip) are known.
 					[cmdEncoder->_mtlRenderEncoder setObjectBytes: &drawInfo length: sizeof(drawInfo) atIndex: pipeline->getDrawInfoBufferIndex()];
diff --git a/MoltenVK/MoltenVK/Commands/MVKCommandPipelineStateFactoryShaderSource.h b/MoltenVK/MoltenVK/Commands/MVKCommandPipelineStateFactoryShaderSource.h
index 31c69d03..19ff659c 100644
--- a/MoltenVK/MoltenVK/Commands/MVKCommandPipelineStateFactoryShaderSource.h
+++ b/MoltenVK/MoltenVK/Commands/MVKCommandPipelineStateFactoryShaderSource.h
@@ -289,6 +289,7 @@ typedef struct {
 	uint32_t indexSize;
 	uint32_t vertsPerPrim;
 	uint32_t isStrip;
+	uint32_t vertexStrides[31];
 } MVKGeometryIndirectParams;
 
 typedef struct {
@@ -297,6 +298,7 @@ typedef struct {
 	int64_t indexBuffer;
 	int32_t baseVertex;
 	uint32_t baseInstance;
+	uint32_t vertexStrides[31];
 	uint8_t topoStrip;
 } MVKGeometryDrawInfo;
 
@@ -342,6 +344,7 @@ kernel void cmdDrawIndirectGeometryConvertBuffers(const device char* srcBuff [[b
 	drawInfo.indexBuffer = int64_t(params.indexBuffer + uint64_t(firstIndex) * params.indexSize);
 	drawInfo.baseVertex = baseVertex;
 	drawInfo.baseInstance = baseInstance;
+	for (uint i = 0; i < 31; i++) { drawInfo.vertexStrides[i] = params.vertexStrides[i]; }
 	drawInfo.topoStrip = uint8_t(params.isStrip);
 }
 
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.h b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.h
index d9f6d1f5..161caa66 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.h
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.h
@@ -323,6 +323,8 @@ public:
 	const MVKStaticBitSet<kMVKMaxBufferCount>& getMtlVertexBuffers() const { return _mtlVertexBuffers; }
 	/** Returns the stride for the given vertex buffer binding (only valid for static strides) */
 	uint32_t getVertexStride(uint32_t binding) const { return _vertexStrides[binding]; }
+	/** Returns the binding stride of the given vertex buffer in a geometry-shader (mesh) pipeline (only valid for static strides). */
+	uint32_t getVkVertexBindingStride(uint32_t binding) const { return _vkVertexBindingStrides[binding]; }
 	const VkViewport* getViewports() const { return _viewports; }
 	const VkRect2D* getScissors() const { return _scissors; }
 	const MTLSamplePosition* getSampleLocations() const { return _sampleLocations; }
@@ -410,6 +412,7 @@ protected:
 	MVKStaticBitSet<kMVKMaxBufferCount> _vkVertexBuffers;
 	MVKStaticBitSet<kMVKMaxBufferCount> _mtlVertexBuffers;
 	uint32_t _vertexStrides[kMVKMaxBufferCount] = {};
+	uint32_t _vkVertexBindingStrides[kMVKMaxBufferCount] = {};
 	MVKPipelineStageResourceInfo _stageResources[kMVKShaderStageFragment + 1] = {};
 
 	id<MTLComputePipelineState> _mtlTessVertexStageState = nil;
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
index e155777b..34548c6f 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKPipeline.mm
@@ -1322,6 +1322,7 @@ static bool usesConstantColor(MVKRenderStateFlags dynamic, const VkPipelineColor
             uint32_t vbIdx = getMetalBufferIndexForVertexAttributeBinding(pVKVB->binding);
             _mtlVertexBuffers.set(vbIdx);
             _vkVertexBuffers.set(pVKVB->binding);
+            _vkVertexBindingStrides[pVKVB->binding] = pVKVB->stride;  // the object stage reads vertices with it
         }
     }
 
