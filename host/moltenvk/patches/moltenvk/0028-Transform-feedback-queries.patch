 			if (used & (1u << b)) { session[4 + b] += w * session[8 + b]; }
 		}
+		if (vertsPerPrim) {
+			query[0] += w / vertsPerPrim;		// Primitives written
+			query[1] += carry / vertsPerPrim;	// Primitives needed: every captured vertex was counted
+		}
