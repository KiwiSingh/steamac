diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
index 4c4cb7ab..44732648 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.h
@@ -685,6 +685,30 @@ public:
 
 	/** Block the current thread until all queues in this device are idle. */
 	VkResult waitIdle();
+
+	/**
+	 * Releases the Metal resource (MTLBuffer, MTLTexture or MTLHeap; the caller's reference) once every
+	 * MTLCommandBuffer committed so far on the queues of this device has completed, removing it from the
+	 * residency set at that time if removeResidency is true. Queue submissions use command buffers that
+	 * do not retain their resources, and semaphores signal from the GPU before their command buffer
+	 * completes, so an app may destroy a resource (after waiting on the semaphore) while the command
+	 * buffer that used it is still alive: releasing it then makes the command buffer fail with
+	 * kIOGPUCommandBufferCallbackErrorInvalidResource (device lost).
+	 */
+	void releaseMTLResourceAfterQueues(id mtlResource, bool removeResidency);
+
+protected:
+	void flushMTLResourceReleases();
+
+	// Resources waiting for releaseMTLResourceAfterQueues(): collected for a short time, then released
+	// together once one marker command buffer per queue completes.
+	struct MVKPendingMTLRelease { id mtlResource; bool removeResidency; };
+	std::mutex _mtlReleaseLock;
+	std::vector<MVKPendingMTLRelease> _mtlReleases;
+	bool _mtlReleaseFlushScheduled = false;
+	std::atomic<uint32_t> _mtlReleaseBatchesInFlight = 0;	// Scheduled flushes and batches whose markers have not completed
+
+public:
 	
 	/** Mark this device (and optionally the physical device) as lost. Releases all waits for this device. */
 	VkResult markLost(bool alsoMarkPhysicalDevice = false);
diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
index bb8e099f..17a2a044 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm
@@ -43,6 +43,8 @@
 #import "CAMetalLayer+MoltenVK.h"
 
 #include <sys/stat.h>
+#include <unistd.h>
+#include <atomic>
 #include <cmath>
 
 using namespace std;
@@ -3870,6 +3872,82 @@ static uint32_t mvkGetEntryProperty(io_registry_entry_t entry, CFStringRef prope
 	return _queuesByQueueFamilyIndex[queueInfo->queueFamilyIndex][queueInfo->queueIndex];
 }
 
+// Delay before the marker command buffers of a batch of releases are committed: destroying many
+// objects at once (level loads, view churn) costs one marker per queue per batch.
+static constexpr int64_t kMVKMTLReleaseBatchDelayNanos = 2 * NSEC_PER_MSEC;
+
+void MVKDevice::releaseMTLResourceAfterQueues(id mtlResource, bool removeResidency) {
+	if ( !mtlResource ) { return; }
+	std::lock_guard<std::mutex> lock(_mtlReleaseLock);
+	_mtlReleases.push_back({ mtlResource, removeResidency });
+	if (_mtlReleaseFlushScheduled) { return; }
+	_mtlReleaseFlushScheduled = true;
+	_mtlReleaseBatchesInFlight++;
+	MVKDevice* dev = this;
+	dispatch_after(dispatch_time(DISPATCH_TIME_NOW, kMVKMTLReleaseBatchDelayNanos),
+				   dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+		dev->flushMTLResourceReleases();
+		dev->_mtlReleaseBatchesInFlight--;
+	});
+}
+
+// Commits one marker command buffer per queue. Command buffers of a queue complete in commit order,
+// so when the markers complete, every command buffer committed before them has completed, and the
+// collected resources are released (and removed from the residency set).
+void MVKDevice::flushMTLResourceReleases() {
+	std::vector<MVKPendingMTLRelease> batch;
+	{
+		std::lock_guard<std::mutex> lock(_mtlReleaseLock);
+		batch.swap(_mtlReleases);
+		_mtlReleaseFlushScheduled = false;
+	}
+	if (batch.empty()) { return; }
+
+	MVKDevice* dev = this;
+	auto* pBatch = new std::vector<MVKPendingMTLRelease>(std::move(batch));
+	auto release = [dev, pBatch]() {
+#if MVK_XCODE_16
+		if (dev->hasResidencySet()) {
+			@synchronized(dev->_residencySet) {
+				for (auto& r : *pBatch) {
+					if (r.removeResidency) { [dev->_residencySet removeAllocation: r.mtlResource]; }
+				}
+				[dev->_residencySet commit];
+			}
+		}
+#endif
+		for (auto& r : *pBatch) { [r.mtlResource release]; }
+		delete pBatch;
+	};
+
+	MVKSmallVector<id<MTLCommandQueue>, 8> mtlQueues;
+	for (auto& queues : _queuesByQueueFamilyIndex) {
+		for (MVKQueue* q : queues) {
+			if (q && q->getMTLCommandQueue()) { mtlQueues.push_back(q->getMTLCommandQueue()); }
+		}
+	}
+	if (mtlQueues.empty()) {
+		release();
+		return;
+	}
+
+	auto* pending = new std::atomic<uint32_t>((uint32_t)mtlQueues.size());
+	_mtlReleaseBatchesInFlight++;
+	@autoreleasepool {
+		for (id<MTLCommandQueue> mtlQueue : mtlQueues) {
+			id<MTLCommandBuffer> mtlCmdBuff = [mtlQueue commandBufferWithUnretainedReferences];
+			[mtlCmdBuff addCompletedHandler: ^(id<MTLCommandBuffer>) {
+				if (pending->fetch_sub(1) == 1) {
+					release();
+					delete pending;
+					dev->_mtlReleaseBatchesInFlight--;
+				}
+			}];
+			[mtlCmdBuff commit];
+		}
+	}
+}
+
 MVKQueue* MVKDevice::getAnyQueue() {
 	for (auto& queues : _queuesByQueueFamilyIndex) {
 		for (MVKQueue* q : queues) {
@@ -5561,6 +5639,9 @@ static uint32_t mvkGetEntryProperty(io_registry_entry_t entry, CFStringRef prope
 		}
 	}
 
+	// Deferred releases of Metal resources (releaseMTLResourceAfterQueues()) use this device.
+	while (_mtlReleaseBatchesInFlight.load()) { usleep(100); }
+
 	for (auto& queues : _queuesByQueueFamilyIndex) {
 		mvkDestroyContainerContents(queues);
 	}
