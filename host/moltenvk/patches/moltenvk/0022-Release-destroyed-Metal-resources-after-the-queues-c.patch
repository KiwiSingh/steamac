From 8aea411655a04a5906e40417410204f00da786a2 Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sun, 4 Oct 2026 02:31:23 +0300
Subject: [PATCH 22/22] Release destroyed Metal resources after the queues'
 command buffers complete

Queue submissions use MTLCommandBuffers that do not retain their resources (with a residency
set), and timeline/binary semaphores signal from the GPU (MTLSharedEvent) before the command
buffer that signals them completes. An app that waits on the semaphore and then frees memory or
destroys a buffer/image (DXVK frees its memory chunks this way) released the Metal object while the
command buffer still referenced it: kIOGPUCommandBufferCallbackErrorInvalidResource, device lost
(Heroes Olden Era), and Metal API validation reports the object as destroyed while required to be
alive by the command buffer.

Release the MTLBuffers, MTLTextures and MTLHeaps of destroyed device memory, buffers, buffer views,
images (and their views and texel buffers) and image views, and remove them from the residency set,
only once every MTLCommandBuffer committed before them on the device's queues has completed. Destroyed
objects are collected for 2 ms, then one empty marker command buffer per queue is committed for the
whole batch (command buffers of a queue complete in commit order); its completion releases the batch.
The device waits for pending batches before it is destroyed.
---
 MoltenVK/MoltenVK/GPUObjects/MVKBuffer.mm     |  6 +-
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.h      | 24 ++++++
 MoltenVK/MoltenVK/GPUObjects/MVKDevice.mm     | 81 +++++++++++++++++++
 .../MoltenVK/GPUObjects/MVKDeviceMemory.mm    |  8 +-
 MoltenVK/MoltenVK/GPUObjects/MVKImage.mm      | 11 ++-
 5 files changed, 116 insertions(+), 14 deletions(-)

diff --git a/MoltenVK/MoltenVK/GPUObjects/MVKBuffer.mm b/MoltenVK/MoltenVK/GPUObjects/MVKBuffer.mm
index 61be7d89..f2276fc3 100644
--- a/MoltenVK/MoltenVK/GPUObjects/MVKBuffer.mm
+++ b/MoltenVK/MoltenVK/GPUObjects/MVKBuffer.mm
@@ -240,9 +240,8 @@
 	MVKLiveResourceSet& live = _device->getLiveResources();
 	if (id<MTLBuffer> buf = _mtlBuffer) {
 		_mtlBuffer = nil;
-		_device->removeResidency(buf);
 		live.remove(buf);
-		[buf release];
+		_device->releaseMTLResourceAfterQueues(buf, true);	// May still be used by command buffers
 	}
 }
 
@@ -364,8 +363,7 @@ static VkDeviceSize getTextureBufferOffsetMask(const VkPhysicalDeviceTexelBuffer
 void MVKBufferView::detachMemory() {
 	if (id<MTLTexture> tex = _mtlTexture) {
 		_device->getLiveResources().remove(tex);
-		_device->removeResidency(tex);
-		[tex release];
+		_device->releaseMTLResourceAfterQueues(tex, true);	// May still be used by command buffers
