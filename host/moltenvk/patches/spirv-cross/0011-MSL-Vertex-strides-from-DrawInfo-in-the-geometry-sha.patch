From 42d2df4ca522d5a492494f3fe69414c63e6961f4 Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sat, 3 Oct 2026 23:03:21 +0300
Subject: [PATCH 11/15] MSL: Vertex strides from DrawInfo in the
 geometry-shader object stage

The object stage fetched vertex attributes with the binding stride baked into the
shader (the pipeline's VkVertexInputBindingDescription::stride). With
VK_DYNAMIC_STATE_VERTEX_INPUT_BINDING_STRIDE that stride is meaningless (zink passes 0
and binds the real stride with vkCmdBindVertexBuffers2), so every vertex read vertex 0
and nothing was rasterized. Read the stride per Metal vertex buffer index from
DrawInfo::vertexStrides, which the API fills in at draw time.
---
 spirv_msl.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index e074d3f2..8b8d0df8 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -1956,6 +1956,8 @@ void CompilerMSL::emit_mesh_wrapper()
 		statement("int64_t indexBuffer;");
 		statement("int32_t baseVertex;");
 		statement("uint32_t baseInstance;");
+		// Vertex buffer strides by Metal buffer index (dynamic strides are only known at draw time).
+		statement("uint32_t vertexStrides[31];");
 		statement("uint8_t topoStrip;");
 
 		end_scope(";");
@@ -2098,7 +2100,7 @@ void CompilerMSL::emit_mesh_wrapper()
 			std::string type_name = get_variable_format_string(variable.format);
 			std::string component = type_name + get_vertex_loader_component_suffix(load_elements);
 			std::string packed = variable.vecsize > 1 ? "packed_" : "";
-			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + vertexIndex * " + std::to_string(variable.stride) + ")";
+			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + vertexIndex * drawInfo->vertexStrides[" + std::to_string(variable.binding) + "])";
 			if (load_elements != parent_type.vecsize)
 			{
 				component = type_name + get_vertex_loader_component_suffix(parent_type.vecsize);
