+// ArrayStride decorates the array type ID, but SPIRType::self of an array type is the ID of its element type
+// (see the parser): look up the ID of this array type.
+uint32_t CompilerMSL::get_robust_array_stride(const SPIRType &type)
+{
+	uint32_t stride = 0;
+	for (auto &id : ir.ids_for_type[TypeType])
+	{
+		if (&get<SPIRType>(id) == &type)
+		{
+			stride = get_decoration(id, DecorationArrayStride);
+			break;
+		}
+	}
+	if (stride == 0 && type.parent_type)
+	{
+		auto &elem_type = get<SPIRType>(type.parent_type);
+		stride = (elem_type.width / 8) * elem_type.vecsize * elem_type.columns;
+	}
+	return stride ? stride : 4;
+}
+
+// The zero value selected by robustBufferAccess2 for an out-of-bounds load of a value of this type.
+string CompilerMSL::robust_zero_expression(const SPIRType &type)
+{
+	if (is_pointer(type))
+		return "nullptr";
+	// Aggregates are value-initialized; T(0) only constructs scalars, vectors and matrices.
+	if (type.basetype == SPIRType::Struct)
+		return join(type_to_glsl(type), "{}");
+	return join(type_to_glsl(type), "(0)");
+}
