From 5807b45b5f515e3887868ed83969870be2456d8b Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sat, 3 Oct 2026 23:42:55 +0300
Subject: [PATCH 15/17] MSL: Vertex attribute conversion in the GS object stage

The object stage loaded vertex attributes with the MSL type of the API's format type, which
for SCALED and NORM formats is float: the bits of R16G16_SSCALED positions (glamor's GL_SHORT
vertices) were read as floats. It also used MSL types that do not exist for 8-bit formats
(byte, ubyte), normalized SNORM by 2^(n-1) instead of 2^(n-1) - 1 without clamping, and
normalized the (0, 0, 0, 1) fill of missing components.

Load the format's components with their memory type (char, uchar, short, ushort, half, float,
int, uint), convert to the shader's component type, normalize NORM formats per the Vulkan
spec, then fill the missing components.
---
 spirv_msl.cpp | 54 +++++++++++++++++++++++++++++++++++----------------
 1 file changed, 37 insertions(+), 17 deletions(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 58458a92..92d227c5 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -1883,18 +1883,18 @@ static const char* get_vertex_loader_component_suffix(uint32_t elements)
 	}
 }
 
-static const char* get_normalization_string(MSLShaderVariableFormat type, bool normalized)
+// Vulkan UNORM: c / (2^n - 1); SNORM: max(c / (2^(n-1) - 1), -1).
+static std::string normalize_vertex_load(MSLShaderVariableFormat type, bool normalized, const std::string &load)
 {
 	if (!normalized)
-		return "";
+		return load;
 	switch (type)
 	{
-		case MSL_SHADER_VARIABLE_FORMAT_UINT16: return " * (1.f/65535.f)";
-		case MSL_SHADER_VARIABLE_FORMAT_UINT8:  return " * (1.f/255.f)";
-		// TODO: Proper positive sint normalization
-		case MSL_SHADER_VARIABLE_FORMAT_INT16: return " * (1.f/32768.f)";
-		case MSL_SHADER_VARIABLE_FORMAT_INT8:  return " * (1.f/128.f)";
-		default: return "";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT16: return load + " * (1.f/65535.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8:  return load + " * (1.f/255.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_INT16: return "max(" + load + " * (1.f/32767.f), -1.f)";
+		case MSL_SHADER_VARIABLE_FORMAT_INT8:  return "max(" + load + " * (1.f/127.f), -1.f)";
+		default: return load;
 	}
 }
 
@@ -1902,8 +1902,8 @@ static const char *get_variable_format_string(MSLShaderVariableFormat format)
 {
 	switch (format)
 	{
-		case MSL_SHADER_VARIABLE_FORMAT_INT8: return "byte";
-		case MSL_SHADER_VARIABLE_FORMAT_UINT8: return "ubyte";
+		case MSL_SHADER_VARIABLE_FORMAT_INT8: return "char";
+		case MSL_SHADER_VARIABLE_FORMAT_UINT8: return "uchar";
 		case MSL_SHADER_VARIABLE_FORMAT_INT16: return "short";
 		case MSL_SHADER_VARIABLE_FORMAT_UINT16: return "ushort";
 		case MSL_SHADER_VARIABLE_FORMAT_INT32: return "int";
@@ -2279,22 +2279,37 @@ void CompilerMSL::emit_mesh_wrapper()
 			std::string parent_type_str = type_to_glsl(get<SPIRType>(type.parent_type), var.self);
 			uint32_t load_elements = std::min<uint32_t>(variable.vecsize, parent_type.vecsize);
 
+			// Load the format's components from memory, convert them to the shader's component type
+			// (integers to float for SCALED formats), normalize NORM formats, then fill the components
+			// the format does not have with (0, 0, 0, 1).
 			std::string type_name = get_variable_format_string(variable.format);
 			std::string component = type_name + get_vertex_loader_component_suffix(load_elements);
-			std::string packed = variable.vecsize > 1 ? "packed_" : "";
+			std::string packed = load_elements > 1 ? "packed_" : "";
 			std::string load_string = "*(device " + packed + component + " *)(vb" + std::to_string(variable.binding) + " + " + std::to_string(variable.offset) + " + spvFetchIndex(drawInfo, " + std::to_string(variable.binding) + ", vertexIndex, positionInGrid.y) * drawInfo->vertexStrides[" + std::to_string(variable.binding) + "])";
+			auto loaded_type = parent_type;
+			loaded_type.vecsize = load_elements;
+			loaded_type.columns = 1;
+			std::string loaded_type_str = type_to_glsl(loaded_type);
+			if (loaded_type_str != component)
+				load_string = loaded_type_str + "(" + load_string + ")";
+			if (parent_type.basetype == SPIRType::Float)
+				load_string = normalize_vertex_load(variable.format, variable.normalized, load_string);
+			else if (parent_type.basetype == SPIRType::Half && variable.normalized)
+			{
+				auto float_type = loaded_type;
+				float_type.basetype = SPIRType::Float;
+				float_type.width = 32;
+				load_string = loaded_type_str + "(" +
+				              normalize_vertex_load(variable.format, true, type_to_glsl(float_type) + "(" + load_string + ")") + ")";
+			}
 			if (load_elements != parent_type.vecsize)
 			{
-				component = type_name + get_vertex_loader_component_suffix(parent_type.vecsize);
-				load_string = component + "(" + load_string;
+				load_string = parent_type_str + "(" + load_string;
 				for (uint32_t i = load_elements; i < parent_type.vecsize; i++)
 					load_string += (i == 3) ? ", 1" : ", 0";
 				load_string += ")";
 			}
-
-			if (parent_type_str != component)
-				load_string = parent_type_str + "(" + load_string + ")";
-			statement(to_name(var.self), " = ", load_string, get_normalization_string(variable.format, variable.normalized), ";");
+			statement(to_name(var.self), " = ", load_string, ";");
 		});
 
 		statement("auto spvVSOut = ", execution.name, "(");
@@ -5979,6 +5994,11 @@ uint32_t CompilerMSL::ensure_correct_input_type(uint32_t type_id, uint32_t locat
 {
 	auto &type = get<SPIRType>(type_id);
 
+	// The object stage of a geometry pipeline fetches vertex attributes itself and converts them to
+	// the shader's types.
+	if (msl_options.for_mesh_pipeline && get_execution_model() == ExecutionModelVertex)
+		return type_id;
+
 	uint32_t max_array_dimensions = strip_array ? 1 : 0;
 
 	// Struct and array types must match exactly.
