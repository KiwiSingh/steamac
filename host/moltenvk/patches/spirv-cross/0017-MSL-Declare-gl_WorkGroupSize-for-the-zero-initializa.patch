From b165c1365faafc392ef0e075751108945196709c Mon Sep 17 00:00:00 2001
From: steamac <steamac@localhost>
Date: Sun, 4 Oct 2026 01:40:58 +0300
Subject: [PATCH 17/17] MSL: Declare gl_WorkGroupSize for the zero
 initialization of workgroup memory

The cooperative zero initialization of workgroup variables with OpConstantNull initializers
(VK_KHR_zero_initialize_workgroup_memory) strides by gl_WorkGroupSize, which was only declared
when the shader itself used the WorkgroupSize builtin: 'use of undeclared identifier
gl_WorkGroupSize' (DXVK compute shaders). Declare it whenever workgroup memory is zero
initialized, from LocalSize, LocalSizeId or the WorkgroupSize constant (including specialization
constants).
---
 spirv_msl.cpp | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/spirv_msl.cpp b/spirv_msl.cpp
index 3589a393..3d2bd7e3 100644
--- a/spirv_msl.cpp
+++ b/spirv_msl.cpp
@@ -367,7 +367,9 @@ void CompilerMSL::build_implicit_builtins()
 	bool need_local_invocation_index =
 		(msl_options.emulate_subgroups && active_input_builtins.get(BuiltInSubgroupId)) || is_mesh_shader() ||
 		needs_workgroup_zero_init || needs_local_invocation_index;
-	bool need_workgroup_size = msl_options.emulate_subgroups && active_input_builtins.get(BuiltInNumSubgroups);
+	// The zero initialization of workgroup memory strides by the workgroup size (emit_workgroup_initialization()).
+	bool need_workgroup_size = (msl_options.emulate_subgroups && active_input_builtins.get(BuiltInNumSubgroups)) ||
+	                           needs_workgroup_zero_init;
 	bool force_frag_depth_passthrough =
 	    get_execution_model() == ExecutionModelFragment && !uses_explicit_early_fragment_test() && need_subpass_input &&
 	    msl_options.enable_frag_depth_builtin && msl_options.input_attachment_is_ds_attachment;
