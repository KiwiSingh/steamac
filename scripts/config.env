# steamac image build configuration (sourced by scripts/build-image.sh and the
# in-container steps). Every external input is pinned here.

# --- SteamOS rootfs source: official signed RAUC bundle (atomupd "vr" variant)
# From https://steamdeck-atomupd.steamos.cloud/meta/holo/steamos/aarch64/vr/stable.json
# (2026-10-03): stable = 20260922.6101926 / 0.3.0.
STEAMOS_IMAGES_URL=https://steamdeck-images.steamos.cloud
STEAMOS_BUILDID=20260922.6101926
STEAMOS_VERSION=0.3.0
STEAMOS_BUNDLE_PATH=vr/20260922.6101926/deckard-stable-20260922.6101926-0.3.0.raucb
STEAMOS_CHUNKS_STORE_PATH=vr/chunks.castr
# sha256 of the .raucb as downloaded (pins the exact bundle; CMS signature is
# verified as well against the Valve key below).
STEAMOS_BUNDLE_SHA256=ae6e2ee724aa68bcd0ad32fe302147567db1261990a74e515ab859ca779203c5
# sha256 of the reconstructed rootfs.img (also cross-checked against the
# signed manifest.raucm inside the bundle).
STEAMOS_ROOTFS_SHA256=d2e69c17165c1d79c18675598590954f06e32fece32c7f9f9caeb345d33c82c7
STEAMOS_ROOTFS_SIZE=10737418240
# RAUC CA "CN=steamdeck-images, O=Valve Corp" (scripts/keys/; the same cert
# shipped in the rootfs as /etc/rauc/trusted_keys/ba942c60.0).
STEAMOS_CA_FP_SHA256=D5:62:FE:FE:25:1B:76:EA:B0:E9:E9:99:35:4A:D1:86:B8:EB:2E:2F:B3:45:0F:AD:BE:C7:F6:AA:59:B6:02:D9

# --- Builder container
BUILDER_IMAGE=steamac-image-builder:2
BUILDER_BASE=debian:trixie@sha256:9cc080028c43b27d2074d63a5f9caf7166d731494965616c1a6d2827a004585c
DEBIAN_SNAPSHOT=20261001T000000Z
DESYNC_VERSION=1.1.4
DESYNC_SHA256=888a17892c31fb91fbf980ef46a8934398da1f061eb1c20d967abf887faf0b34

# --- Disk layout (MiB). Valve device layout (QDL lun0 / repair_device.sh) except
# var and home, see comments in scripts/steps/40-disk.sh.
PART_SIZE_ESP=256
PART_SIZE_EFI=64
PART_SIZE_ROOT=10240
PART_SIZE_VAR=1024
# home is the last partition; default 64 GiB (sparse on the host), override
# with HOME_SIZE_GIB=... ./scripts/build-image.sh
HOME_SIZE_GIB=${HOME_SIZE_GIB:-64}

# --- Guest login (documented in guest/layer/README section of build output):
# user `steamos` gets this password via the /etc overlay upper on var-A/var-B.
STEAMOS_PASSWORD=${STEAMOS_PASSWORD:-steamos}
